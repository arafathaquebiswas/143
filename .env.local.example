# ---------------------------------------------------------------------------
# Supabase  ->  Project Settings  ->  API
# ---------------------------------------------------------------------------

# Your project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "publishable" key. Safe to expose in the browser: every table and
# storage object is protected by Row Level Security, so this key alone grants
# nothing without a logged-in, allow-listed session.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
